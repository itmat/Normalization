checkpoint sam2genes_gnorm_split:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id)
    output:
        suffixes = "results/READS/{sample_id}/GNORM/{unique_nu}/sam2genes_splits.txt",
        dir = directory("results/READS/{sample_id}/GNORM/{unique_nu}/sam2genes_splits/"),
    container:
        config['containers']['samtools']
    params:
        n_rows_per_batch = 5_000_000
    shell:
        # Perform the splits and write out the split suffixes
        "mkdir {output.dir} && samtools view {input.bam} | split -l {params.n_rows_per_batch} - {output.dir}/sam2genes_temp. && find {output.dir}/* | sed -nE \"s/.*sam2genes_temp.(.*)/\\1/p\" > {output.suffixes}"


# TODO: sam2genes_gnorm_split splits the sam file up into smaller files for parallelism, but Snakemake cannot use a checkpoint
# with temporary output. Therefore, the output is currently permanent, which is undesirable as it is large and redundant
# Since the actual split files are not directly 'outputs' of the sam2genes_gnorm_split rule, it my be possible to delete them
# in sam2genes_gnorm after using them
rule sam2genes_gnorm:
    input:
        suffixes = "results/READS/{sample_id}/GNORM/{unique_nu}/sam2genes_splits.txt",
        split = "results/READS/{sample_id}/GNORM/{unique_nu}/sam2genes_splits/sam2genes_temp.{suffix}",
        ens = port_config['GENE_INFO_FILE'],
    output:
        "results/READS/{sample_id}/GNORM/{unique_nu}/sam2genes_splits/sam2genes_temp.{suffix}.txt.gz"
    params:
        paired_end = paired_end_flag,
        orientation = orientation_flag,
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/sam2genes.pl {input.split} {input.ens} {output} {params.paired_end} {params.orientation}"

def sam2genes_agg(wildcards):
        out = list(checkpoints.sam2genes_gnorm_split.get(sample_id = wildcards.sample_id, unique_nu = wildcards.unique_nu).output)
        with out[0].open() as f:
            suffixes = f.read().splitlines()
        return [f"results/READS/{wildcards.sample_id}/GNORM/{wildcards.unique_nu}/sam2genes_splits/sam2genes_temp.{suffix}.txt.gz"
                for suffix in suffixes]

rule cat_genes_files:
    input:
        sam2genes_agg
    output:
        "results/READS/{sample_id}/GNORM/{unique_nu}/{sample_id}.filtered_{u_nu}.txt.gz",
    shell:
        "zcat {input} | gzip > {output}"

rule genefilter:
    input:
        sam = "results/READS/{sample_id}/GNORM/{unique_nu}/{sample_id}.filtered_{u_nu}.sam.gz",
        genefile = "results/READS/{sample_id}/GNORM/{unique_nu}/{sample_id}.filtered_{u_nu}.txt.gz",
    output:
        expand("results/READS/{{sample_id}}/GNORM/{{unique_nu}}/{{sample_id}}.filtered_{{u_nu}}.genes{type}.sam.gz", type=sense_types),
        expand("results/READS/{{sample_id}}/GNORM/{{unique_nu}}/{{sample_id}}.filtered_{{u_nu}}.genes{type}.linecount.txt", type=sense_types),
    params:
        stranded = stranded_flag,
        paired = paired_end_flag,
        outname = "results/READS/{sample_id}/GNORM/{unique_nu}/{sample_id}.filtered_{u_nu}.genes.sam.gz",
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/genefilter.pl {input.sam} {input.genefile} {params.outname} {params.paired} {params.stranded}"

rule copy_lcfiles:
    input:
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.genes{type}.linecount.txt", type=sense_types, sample_id = sample_ids),
        expand("results/READS/{sample_id}/GNORM/NU/{sample_id}.filtered_nu.genes{type}.linecount.txt", type=sense_types, sample_id = sample_ids),
    output:
        expand("results/STATS/lineCounts/gene.unique{type}.lc.txt", type = sense_types),
        expand("results/STATS/lineCounts/gene.nu{type}.lc.txt", type = sense_types),
    params:
        out_dir = "results/STATS/lineCounts/",
        input_dirs = expand("results/READS/{sample_id}/", sample_id = sample_ids),
        stranded = stranded_flag,
    container:
        config['containers']['perl']
    shell:
        "perl /workflow/scripts/copy_lcfiles.pl {params.out_dir} {params.input_dirs} {params.stranded} -gnorm"

