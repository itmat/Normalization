import yaml
with open(workflow.source_path("config.yaml")) as cfg:
    default_config = yaml.load(cfg, yaml.Loader)
default_config.update(config)
config = default_config

def sample_to_bam(sample_id):
    return config['aligned_files'][sample_id]

def read_port_config(cfg_file):
    config = dict()
    with open(cfg_file, "rt") as cfg_file:
        for line in cfg_file:
            line = line.strip()
            if line.startswith("#"):
                continue
            elif len(line) == 0:
                continue
            else:
                splits = line.split(" = ")
                if len(splits) == 1:
                    before = splits[0]
                    config[before] = None
                else:
                    before, after = splits
                    config[before] = after
    return config
port_config = read_port_config(config['port_config'])

sample_ids = list(config['aligned_files'].keys())
paired_end_flag = "" if config['paired_end'] else '-se'
orientation_flag = '' if not port_config['STRANDED'] else "-str_f" if port_config['FWD'] == "TRUE" else "-str_r"
stranded_flag = '-stranded' if port_config['STRANDED'] == "TRUE" else '',
sense_types = [".sense", ".antisense"] if port_config['STRANDED'] == "TRUE" else [""]

rule all:
    input:
        "results/precheck.pass",
        "results/check_samformat.pass",
        "results/STATS/total_num_reads.txt",
        "results/STATS/mappingstats_summary.txt",
        "results/one-line.fa",
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.sam.gz", sample_id = sample_ids),
        "results/STATS/percent_reads_chr_gene.txt",
        "results/READS/master_list_of_genes.txt",
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.genefilter.sense.txt.gz", sample_id = sample_ids),
        expand("results/READS/{sample_id}/GNORM/NU/{sample_id}.filtered_nu.genefilter.sense.txt.gz", sample_id = sample_ids),
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.genes{type}.sam.gz", sample_id = sample_ids, type = sense_types),
        expand("results/READS/{sample_id}/GNORM/NU/{sample_id}.filtered_nu.genes{type}.sam.gz", sample_id = sample_ids, type = sense_types),
        expand("results/STATS/lineCounts/gene.unique{type}.lc.txt", type = sense_types),
        expand("results/STATS/lineCounts/gene.nu{type}.lc.txt", type = sense_types),
        "results/STATS/GENE/sense_vs_antisense_genemappers_NU.txt",
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.genefilter{type}.genequants", sample_id = sample_ids, type = sense_types),
        expand("results/READS/{sample_id}/GNORM/NU/{sample_id}.filtered_nu.genefilter{type}.genequants", sample_id = sample_ids, type = sense_types),
        expand("results/STATS/GENE/percent_genemappers_{unique_nu}_{sense}.txt", unique_nu = ["Unique", "NU"], sense=["sense", "antisense"]),

rule precheck:
    input:
        aligned = config['aligned_files'].values(),
        cfg = config['port_config'],
    output:
        touch("results/precheck.pass")
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/run_normalization --aligned_files {input.aligned} --cfg {input.cfg}"

rule sample_ids:
    output:
        "results/sample_ids.txt"
    run:
        with open(output[0], 'wt') as f:
            for sample_id in sample_ids:
                f.write(f"{sample_id}\n")

rule get_total_num_reads:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id) 
    output:
        "results/SAMPLES/{sample_id}/total_num_reads.txt"
    container:
        config['containers']['samtools']
    shell:
        "samtools view -c -F 2432 {input.bam} > {output}"

rule get_total_num_reads_agg:
    input:
        tnr = expand("results/SAMPLES/{sample_id}/total_num_reads.txt", sample_id = sample_ids)
    output:
        tnr = "results/STATS/total_num_reads.txt"
    run:
        with open(output.tnr, 'wt') as out:
            for sample_id, tnrf in zip(sample_ids, input.tnr):
                tot_num_reads = open(tnrf).read()
                out.write(f"{sample_id}\t{tot_num_reads}")

rule check_samformat:
    input:
        [sample_to_bam(sample_id) for sample_id in sample_ids]
    output:
        touch("results/check_samformat.pass")
    params:
        pe = paired_end_flag,
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/check_samformat.pl {input} {params.pe}"

rule sam2mappingstats:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id),
        tnr = "results/SAMPLES/{sample_id}/total_num_reads.txt",
    output:
        "results/SAMPLES/{sample_id}/{sample_id}_mappingstats.txt"
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/sam2mappingstats.pl {input.bam} {output} -numreads `cat {input.tnr}`"

rule getstats:
    input:
        expand("results/SAMPLES/{sample_id}/{sample_id}_mappingstats.txt", sample_id=sample_ids),
