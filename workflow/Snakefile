import yaml
with open(workflow.source_path("config.yaml")) as cfg:
    default_config = yaml.load(cfg, yaml.Loader)
default_config.update(config)
config = default_config

sample_ids = list(config['aligned_files'].keys())
paired_end_flag = "" if config['paired_end'] else '-se'

def sample_to_bam(sample_id):
    return config['aligned_files'][sample_id]

def read_port_config(cfg_file):
    config = dict()
    with open(cfg_file, "rt") as cfg_file:
        for line in cfg_file:
            line = line.strip()
            if line.startswith("#"):
                continue
            elif len(line) == 0:
                continue
            else:
                splits = line.split(" = ")
                if len(splits) == 1:
                    before = splits[0]
                    config[before] = None
                else:
                    before, after = splits
                    config[before] = after
    return config
port_config = read_port_config(config['port_config'])

rule all:
    input:
        "results/precheck.pass",
        "results/check_samformat.pass",
        "results/STATS/total_num_reads.txt",
        "results/STATS/mappingstats_summary.txt",
        "results/one-line.fa",
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.sam.gz", sample_id = sample_ids),
        "results/STATS/percent_reads_chr_gene.txt",
        "results/READS/master_list_of_genes.txt",

rule precheck:
    input:
        aligned = config['aligned_files'].values(),
        cfg = config['port_config'],
    output:
        touch("results/precheck.pass")
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/run_normalization --aligned_files {input.aligned} --cfg {input.cfg}"

rule get_total_num_reads:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id) 
    output:
        "results/SAMPLES/{sample_id}/total_num_reads.txt"
    container:
        config['containers']['samtools']
    shell:
        "samtools view -c -F 2432 {input.bam} > {output}"

rule get_total_num_reads_agg:
    input:
        tnr = expand("results/SAMPLES/{sample_id}/total_num_reads.txt", sample_id = sample_ids)
    output:
        tnr = "results/STATS/total_num_reads.txt"
    run:
        with open(output.tnr, 'wt') as out:
            for sample_id, tnrf in zip(sample_ids, input.tnr):
                tot_num_reads = open(tnrf).read()
                out.write(f"{sample_id}\t{tot_num_reads}")

rule check_samformat:
    input:
        [sample_to_bam(sample_id) for sample_id in sample_ids]
    output:
        touch("results/check_samformat.pass")
    params:
        pe = paired_end_flag,
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/check_samformat.pl {input} {params.pe}"

rule sam2mappingstats:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id),
        tnr = "results/SAMPLES/{sample_id}/total_num_reads.txt",
    output:
        "results/SAMPLES/{sample_id}/{sample_id}_mappingstats.txt"
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/sam2mappingstats.pl {input.bam} {output} -numreads `cat {input.tnr}`"

rule getstats:
    input:
        expand("results/SAMPLES/{sample_id}/{sample_id}_mappingstats.txt", sample_id=sample_ids),
    output:
        mappingstats = "results/STATS/mappingstats_summary.txt",
        mito = "results/STATS/mitochondrial_percents.txt",
    params:
        mito = port_config['CHRM']
    container:
        config['containers']['perl']
    shell:
        "perl /workflow/scripts/getstats.pl {input} -mito_file {output.mito} -summary_file {output.mappingstats} -mito {params.mito}"

rule modify_to_onelinefa:
    input:
        fa = port_config['GENOME_FA'],
    output:
        fa = "results/one-line.fa"
        #TODO: make this temporary?
    container:
        #TODO: we need a better way to handle this container
        config['containers']['perl']
    shell:
        'perl /workflow/scripts/rum-2.0.5_05/bin/modify_fa_to_have_seq_on_one_line.pl {input.fa} > {output.fa};'

rule filtersam_gnorm:
    input:
        bam = lambda wildcards: sample_to_bam(wildcards.sample_id),
    output:
        unique = "results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.sam.gz",
        NU = "results/READS/{sample_id}/GNORM/NU/{sample_id}.filtered_nu.sam.gz",
    params:
        paired_end = paired_end_flag,
        mito = port_config['CHRM']
    container:
        config['containers']['samtools']
    shell:
        # TODO: should -u/-nu ever be set? Appears to happen in PORT 0.8.5 if there are no NU mappers at all
        "perl /workflow/scripts/filter_sam_gnorm.pl {input} {output} {params.paired_end} -mito {params.mito}"

rule get_percent_numchr:
    input:
        "results/READS/{sample_id}/{norm_type}/Unique/{sample_id}.filtered_u.sam.gz"
    output:
        "results/READS/{sample_id}/{norm_type}/Unique/{sample_id}.filtered_u.numchr_count.txt"
    container:
        config['containers']['perl']
    shell:
        "perl /workflow/scripts/get_percent_numchr.pl {input} {output}"

rule get_chr_stats_gnorm:
    input:
        expand("results/READS/{sample_id}/GNORM/Unique/{sample_id}.filtered_u.numchr_count.txt", sample_id = sample_ids),
    output:
        "results/STATS/percent_reads_chr_gene.txt"
    container:
        config['containers']['perl']
    shell:
        "perl /workflow/scripts/get_chr_stats.pl {output} {input}"

rule get_readlength:
    input:
        bam = [sample_to_bam(sample_id) for sample_id in sample_ids],
    output:
        "results/READS/readlength.txt"
    container:
        config['containers']['samtools']
    shell:
        "perl /workflow/scripts/get_readlength.pl {input} > {output}"

rule get_master_list_of_genes:
    input:
        ens = port_config['GENE_INFO_FILE'],
        readlength = "results/READS/readlength.txt",
    output:
        "results/READS/master_list_of_genes.txt"
    container:
        config['containers']['perl']
    params:
        stranded = '-stranded' if port_config['STRANDED'] == "TRUE" else '',
    shell:
        "perl /workflow/scripts/get_master_list_of_genes.pl {input.ens} {output} {params.stranded} -readlength `cat {input.readlength}`"
